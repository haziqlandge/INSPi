# Copy to .env and fill in. Only GROQ_API_KEY is required; the rest are optional free providers.

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional second key (another account) for the same provider; used while the first waits for quota or is out of it.
# Any provider accepts one: GEMINI_API_KEY_FALLBACK, OPENROUTER_API_KEY_FALLBACK, CLOUDFLARE_API_TOKEN_FALLBACK.
GROQ_API_KEY_FALLBACK=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://dash.cloudflare.com  (Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
